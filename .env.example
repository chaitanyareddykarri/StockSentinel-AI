# ====================================================================
# StockSentinel AI — Environment Configuration Example
# Copy this file to .env.local for local development.
# For Vercel, set these variables in Project Settings > Environment Variables.
# ====================================================================

# --------------------------------------------------------------------
# 1. Persistent Database & Auth: Supabase (PostgreSQL)
# [REQUIRED FOR PERMANENT PRODUCTION PERSISTENCE & USER AUTH]
# When left unset or with placeholder values, the app automatically runs
# in Demo Mode using an in-memory/session data store with realistic demo data
# and 1-click Guest/Evaluator authentication.
# --------------------------------------------------------------------
# (Public) Supabase Project URL (from Supabase Dashboard > Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# (Public) Supabase Anonymous Client Key (from Supabase Dashboard > Settings > API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder

# (Server-Only) Supabase Service Role Key (Do NOT expose with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder

# --------------------------------------------------------------------
# 2. Public Application URL & OAuth Callback
# Used for metadata, OAuth redirects, and public domain resolution.
# In Supabase Dashboard > Authentication > URL Configuration:
# - Site URL: https://your-domain.vercel.app
# - Redirect URLs: https://your-domain.vercel.app/auth/callback
# --------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://stocksentinel-ai.vercel.app

# --------------------------------------------------------------------
# 3. AI Copilot Provider (Gemini / OpenAI)
# [SERVER-ONLY - NEVER EXPOSE TO CLIENT]
# The application automatically detects whichever key you provide:
# - If GEMINI_API_KEY is supplied, Google Gemini 1.5 Flash is used.
# - If OPENAI_API_KEY is supplied, OpenAI GPT-4o-mini is used.
# - If both or neither are provided, appropriate priority/fallback applies.
# - When unconfigured, the system runs explainable Poisson Baseline Analysis
#   and informs the user that AI reasoning is awaiting an API key.
# --------------------------------------------------------------------
# Google Gemini API Key (from https://aistudio.google.com/)
GEMINI_API_KEY=

# OpenAI API Key (from https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# --------------------------------------------------------------------
# 4. Optional External Python AI/ML Service
# [OPTIONAL]
# If configured, detection requests will be proxied to this FastAPI endpoint.
# If unset or unreachable, StockSentinel AI automatically falls back to its
# built-in TypeScript statistical baseline engine.
# --------------------------------------------------------------------
# Server-only: URL of the hosted python-service (e.g., Render, Railway, Modal)
DETECTION_SERVICE_URL=

