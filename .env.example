# ====================================================================
# StockSentinel AI — Environment Configuration Template
# Copy this file to .env.local for local development.
# For Vercel, set these variables in Project Settings > Environment Variables.
# NEVER commit secret keys or production service role keys to Git.
# ====================================================================

# --------------------------------------------------------------------
# 1. Supabase Persistent PostgreSQL Database & Supabase Auth
# [REQUIRED FOR PERMANENT PRODUCTION PERSISTENCE & USER AUTH]
# --------------------------------------------------------------------
# Supabase Project URL (from Supabase Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Public Key (Safe to expose to browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder

# Supabase Service Role Secret Key (SERVER-ONLY - Never prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder

# --------------------------------------------------------------------
# 2. Public Application URL & OAuth Configuration
# --------------------------------------------------------------------
# Used for metadata and OAuth redirect resolution
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app

# Google OAuth 2.0 Web Client ID (from Google Cloud Console Credentials)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# --------------------------------------------------------------------
# 3. AI Copilot Diagnostics (Google Gemini / OpenAI)
# [SERVER-ONLY - NEVER EXPOSE TO CLIENT]
# --------------------------------------------------------------------
# Google Gemini API Key (from https://aistudio.google.com/)
GEMINI_API_KEY=your-gemini-api-key-placeholder

# Optional OpenAI API Key (from https://platform.openai.com/api-keys)
OPENAI_API_KEY=your-openai-api-key-placeholder

# --------------------------------------------------------------------
# 4. Optional External Python AI/ML Service
# [OPTIONAL]
# --------------------------------------------------------------------
DETECTION_SERVICE_URL=
